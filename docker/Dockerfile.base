FROM ghcr.io/cyber-dojo-languages/gplusplus:4a36012
LABEL maintainer=estermann.michel@gmail.com

COPY install.sh .
RUN ./install.sh && rm ./install.sh

# A kata's test run reads precompiled GoogleTest and cucumber-cpp headers
# instead of parsing them again on every [test] press. The script explains why
# it precompiles a wrapper rather than a single header, why its flags have to
# match the start-point makefile's, and fails the build if gcc will not use the
# result.
COPY build_pch.sh .
RUN bash ./build_pch.sh && rm ./build_pch.sh

